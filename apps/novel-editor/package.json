  },
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "pnpm build:renderer",
    "build:renderer": "vite build",
    "dev:renderer": "vite",
    "stage:codex": "node scripts/stage-codex-sidecar.mjs",
    "bundle": "tauri build",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"for (const path of ['dist','src-tauri/binaries','src-tauri/target']) require('node:fs').rmSync(path,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@kohon/editor-core": "workspace:*",
    "@kohon/project-store": "workspace:*",
    "@openai/codex": "0.160.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-opener": "2.7.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
